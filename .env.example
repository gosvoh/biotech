# Database (Prisma / SQLite)
DATABASE_URL="file:./dev.db"
SHADOW_DATABASE_URL="file:./shadow.db"

# Mail (SMTP — задать вопрос декану)
MAIL_USER="user@example.com"
MAIL_PASS="your-smtp-password"
MAIL_TO="dean@example.com"

# Auth.js email sign-in (Nodemailer provider).
# Раздельные параметры SMTP — спецсимволы в пароле писать как есть, без кодирования.
# Порт 465 = implicit TLS (secure), 587 = STARTTLS (определяется автоматически).
EMAIL_SERVER_HOST="smtp.example.com"
EMAIL_SERVER_PORT="587"
EMAIL_SERVER_USER="no-reply@example.com"
EMAIL_SERVER_PASSWORD="your-smtp-password"
EMAIL_FROM="no-reply@example.com"

# DKIM signing
DKIM_DOMAIN="example.com"
DKIM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Dev only: bypass admin authorization to inspect /admin without signing in.
# Ignored unless NODE_ENV !== "production", so it is safe to leave configured.
DISABLE_ADMIN_AUTH="false"

# Gates POST /api/internal/revalidate (x-revalidate-secret header).
# Shared by the web server, VK worker and startup cache warmup.
# The standard dev/start/container supervisor generates a shared temporary
# secret when omitted. If configured, use a random value in the server env.
REVALIDATE_SECRET=""

# VK news import (server only). Use a token that supports wall.get and wall.getById.
VK_GROUP_ID="biotech.itmo"
VK_GROUP_TOKEN=""
# Optional application ID; reading the wall does not require this value.
VK_APP_ID=""
