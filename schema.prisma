datasource db {
    provider          = "sqlite"
    url               = env("DATABASE_URL")
    shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
    output   = "./src/lib/db/client"
}

model User {
    id            String    @id @default(cuid())
    name          String?
    email         String?   @unique
    emailVerified DateTime?
    image         String?
    accounts      Account[]
    sessions      Session[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    role String @default("user")
}

model Account {
    id                String  @id @default(cuid())
    userId            String
    type              String
    provider          String
    providerAccountId String
    refresh_token     String?
    access_token      String?
    expires_at        Int?
    token_type        String?
    scope             String?
    id_token          String?
    session_state     String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([provider, providerAccountId])
}

model Session {
    id           String   @id @default(cuid())
    sessionToken String   @unique
    userId       String
    expires      DateTime
    user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model VerificationToken {
    identifier String
    token      String
    expires    DateTime

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt @default(now())

    @@unique([identifier, token])
}

model Member {
    id         String  @id @default(cuid())
    image      String?
    firstName  String
    lastName   String
    middleName String?
    position   String?
    email      String?
    phone      String?
    sortOrder  Int     @default(0)

    Department   Department? @relation(fields: [departmentId], references: [id])
    departmentId String?

    disciplines     Discipline[]
    scientificWorks ScientificWork[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt @default(now())
}

model Department {
    id   String @id @default(cuid())
    name String

    members Member[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt @default(now())
}

model Discipline {
    id    String @id @default(cuid())
    title String

    members Member[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt @default(now())
}

model ScientificWork {
    id    String @id @default(cuid())
    title String

    members Member[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt @default(now())
}

model News {
    id     String  @id @default(cuid())
    title  String
    text   String
    links  String
    hidden Boolean @default(false)
    date   String

    tags   NewsTags[]
    images NewsImages[]
    vkImport VkImportPost?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt @default(now())
}

model NewsTags {
    id    String @id @default(cuid())
    title String
    normalizedTitle String? @unique

    news News[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt @default(now())
}

model NewsImages {
    id String @id @default(cuid())
    sortOrder Int @default(0)

    News   News   @relation(fields: [newsId], references: [id], onDelete: Cascade)
    newsId String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt @default(now())
}

model Publication {
    id String @id @default(cuid())

    year    String
    title   String
    authors String
    link    String

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt @default(now())
}

model VkImportSource {
    groupId String @id
    name String
    screenName String
    cursorDate Int?
    lastAttemptAt DateTime?
    lastSuccessAt DateTime?
    lastError String?
    lastResult Json?
    needsRevalidate Boolean @default(false)
    revalidationRevision Int @default(0)
    leaseToken String?
    leaseUntil DateTime?
    recentPostIds Json?
    lastSyncAt DateTime?
    lastSyncError String?
    lastSyncResult Json?
    posts VkImportPost[]
}

model VkImportPost {
    groupId String
    postId String
    source VkImportSource @relation(fields: [groupId], references: [groupId], onDelete: Cascade)
    newsId String? @unique
    news News? @relation(fields: [newsId], references: [id], onDelete: SetNull)
    status String
    snapshot Json?
    selectionBasis Json?
    syncEnabled Boolean @default(true)
    manualHidden Boolean @default(false)
    manualDeleted Boolean @default(false)
    autoHiddenReason String?
    lastCheckedAt DateTime?
    lastCheckError String?
    deletionRetry Boolean @default(false)
    deletionRetryAt DateTime?
    revision Int @default(0)
    attempts Int @default(0)
    error String?

    @@id([groupId, postId])
    @@index([groupId, status])
}
